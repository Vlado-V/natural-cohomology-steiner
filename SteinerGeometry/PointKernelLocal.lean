module

public import OAI.AlgebraicGeometry.Seshadri.Geometry.EtalePointChart
public import Mathlib.RingTheory.Flat.TorsionFree

set_option backward.privateInPublic true
@[expose] public section

namespace SteinerGeometry
noncomputable section

/-- Near a rational point of a smooth curve, its ideal is generated by one
non-zero-divisor. Both the neighborhood and generator are constructed from
centered étale coordinates. -/
theorem smooth_curve_point_kernel_local
    {K S : Type} [Field K] [CommRing S] [Algebra K S]
    [Algebra.IsStandardSmoothOfRelativeDimension 1 K S] (ρ : S →ₐ[K] K) :
    ∃ s : S, ρ s ≠ 0 ∧ ∃ t : Localization.Away s,
      IsRegular t ∧
      (RingHom.ker ρ).map (algebraMap S (Localization.Away s)) = Ideal.span {t} := by
  obtain ⟨x, s, hs, _, het, hker⟩ :=
    OAI.MaximalSeshadri.AlgebraicJets.exists_centered_etale_point_chart 1 ρ
  let φ : MvPolynomial (Fin 1) K →+* Localization.Away s :=
    (algebraMap S (Localization.Away s)).comp (MvPolynomial.aeval x).toRingHom
  let : Algebra (MvPolynomial (Fin 1) K) (Localization.Away s) := φ.toAlgebra
  let : Algebra.Etale (MvPolynomial (Fin 1) K) (Localization.Away s) := het
  let t := φ (MvPolynomial.X 0)
  have hr : IsRegular (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) :=
    IsRegular.of_ne_zero (MvPolynomial.X_ne_zero 0)
  have ht : IsLeftRegular t := by
    have h := Module.Flat.isSMulRegular_of_isRegular (M := Localization.Away s) hr
    change Function.Injective (fun z => t * z)
    simpa only [IsSMulRegular, Algebra.smul_def, RingHom.algebraMap_toAlgebra] using h
  refine ⟨s, hs, t, (Commute.isRegular_iff (fun b => mul_comm t b)).mpr ht, ?_⟩
  rw [hker, MvPolynomial.idealOfVars, Ideal.map_span]
  congr 1
  ext z
  simp only [Set.mem_image, Set.mem_range, Set.mem_singleton_iff]
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    dsimp [t]
    rw [Subsingleton.elim i 0]
    rfl
  · intro h
    subst z
    exact ⟨MvPolynomial.X 0, ⟨0, rfl⟩, rfl⟩


end
end SteinerGeometry
