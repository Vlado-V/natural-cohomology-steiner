import Mathlib.Algebra.Module.ZLattice.Basic
import Mathlib.Analysis.Complex.Basic
import Mathlib.LinearAlgebra.Complex.FiniteDimensional
import Mathlib.Order.Interval.Set.Infinite
import Mathlib.Tactic

namespace SteinerGeometry

noncomputable section

/-- The square lattice generated by `1` and `I` in the complex line. -/
def squareLattice : Submodule ℤ ℂ := Submodule.span ℤ (Set.range Complex.basisOneI)

instance squareLattice_discrete : DiscreteTopology squareLattice := by
  unfold squareLattice
  infer_instance

instance squareLattice_full : IsZLattice ℝ squareLattice := by
  unfold squareLattice
  infer_instance

abbrev SquareTorus := ℂ ⧸ squareLattice.toAddSubgroup

instance squareTorus_compact : CompactSpace SquareTorus := by
  apply isCompact_univ_iff.mp
  have hc := IsZLattice.isCompact_range_of_periodic squareLattice
    (QuotientAddGroup.mk : ℂ → SquareTorus)
    QuotientAddGroup.continuous_mk (by
      intro z w hw
      rw [QuotientAddGroup.mk_add, (QuotientAddGroup.eq_zero_iff w).mpr hw, add_zero])
  rwa [Set.range_eq_univ.mpr QuotientAddGroup.mk_surjective] at hc

theorem squareLattice_coordinates (z : ℂ) (hz : z ∈ squareLattice) :
    (∃ a : ℤ, (a : ℝ) = z.re) ∧ ∃ b : ℤ, (b : ℝ) = z.im := by
  have h := (Complex.basisOneI.mem_span_iff_repr_mem ℤ z).mp hz
  constructor
  · simpa [Complex.coe_basisOneI_repr] using h 0
  · simpa [Complex.coe_basisOneI_repr] using h 1

/-- The real interval of length one embeds in the square torus. -/
def squareTorusArc (t : Set.Ico (0 : ℝ) 1) : SquareTorus :=
  QuotientAddGroup.mk ((t : ℝ) : ℂ)

theorem squareTorusArc_injective : Function.Injective squareTorusArc := by
  intro u v h
  have hmem : ((u : ℝ) : ℂ) - ((v : ℝ) : ℂ) ∈ squareLattice.toAddSubgroup :=
    QuotientAddGroup.eq_iff_sub_mem.mp h
  obtain ⟨⟨a, ha⟩, _⟩ := squareLattice_coordinates _ hmem
  have ha' : (a : ℝ) = (u : ℝ) - (v : ℝ) := by simpa using ha
  have hlo : (-1 : ℝ) < a := by rw [ha']; linarith [u.property.1, v.property.2]
  have hhi : (a : ℝ) < 1 := by rw [ha']; linarith [u.property.2, v.property.1]
  have hlo' : (-1 : ℤ) < a := by exact_mod_cast hlo
  have hhi' : a < (1 : ℤ) := by exact_mod_cast hhi
  have haz : a = 0 := by omega
  apply Subtype.ext
  simpa [haz, sub_eq_zero] using ha'.symm

instance squareTorus_infinite : Infinite SquareTorus := by
  let : Infinite (Set.Ico (0 : ℝ) 1) := Set.Ico.infinite zero_lt_one
  exact Infinite.of_injective squareTorusArc squareTorusArc_injective

/-- The usual positive definite Hermitian form on the complex line. -/
def lineHermitian : ℂ →ₗ⋆[ℂ] ℂ →ₗ[ℂ] ℂ where
  toFun u :=
    { toFun := fun v => star u * v
      map_add' := by intros; ring
      map_smul' := by intros; simp [mul_comm, mul_assoc] }
  map_add' := by intros; ext; simp [add_mul]
  map_smul' := by intros; ext; simp [mul_assoc]

@[simp] theorem lineHermitian_apply (u v : ℂ) :
    lineHermitian u v = star u * v := rfl

theorem lineHermitian_symm (u v : ℂ) :
    lineHermitian v u = star (lineHermitian u v) := by
  simp [mul_comm]

theorem lineHermitian_positive (u : ℂ) (hu : u ≠ 0) :
    0 < (lineHermitian u u).re := by
  simpa [Complex.normSq_apply, pow_two] using Complex.normSq_pos.mpr hu

theorem lineHermitian_integral (u : ℂ) (hu : u ∈ squareLattice.toAddSubgroup)
    (v : ℂ) (hv : v ∈ squareLattice.toAddSubgroup) :
    ∃ m : ℤ, (lineHermitian u v).im = (m : ℝ) := by
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := squareLattice_coordinates u hu
  obtain ⟨⟨c, hc⟩, ⟨d, hd⟩⟩ := squareLattice_coordinates v hv
  refine ⟨a * d - b * c, ?_⟩
  simp [Complex.mul_im, ← ha, ← hb, ← hc, ← hd]
  ring

end
end SteinerGeometry
