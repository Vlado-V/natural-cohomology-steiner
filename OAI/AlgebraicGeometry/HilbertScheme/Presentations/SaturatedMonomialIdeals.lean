import OAI.AlgebraicGeometry.HilbertScheme.Presentations.Hilbert.Polynomial
import OAI.AlgebraicGeometry.HilbertScheme.Presentations.MonomialFinitenessIs
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Data.Finsupp.PWO

/-! # Saturated Monomial Ideals -/

namespace OAI.AlgebraicGeometry.HilbertScheme.Presentations.SaturatedMonomialIdeals.GradedHilbert

noncomputable section

/-!
Monomial ideals with a fixed Hilbert polynomial.
The exponent order is connected here to actual ideals of the polynomial
ring. Saturation and the Hilbert polynomial are the algebraic conditions
on the graded coordinate quotients, rather than finiteness assumptions.
-/

open _root_.MvPolynomial

universe u

variable {R : Type u} [CommRing R] {n : ℕ}

/-- An ideal generated by monic monomials. -/
def IsMonomial (I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)) : Prop :=
  ∃ S : Set (Fin (n + 1) →₀ ℕ), I = Ideal.span ((fun a => monomial a (1 : R)) '' S)

def monomialExponents (I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)) :
    Set (MonomialFinitenessIs.MonomialFiniteness.Exponent (n + 1)) :=
  {a | monomial (Finsupp.equivFunOnFinite.symm a) (1 : R) ∈ I}

theorem monomialExponents_isUpperSet (I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)) :
    IsUpperSet (monomialExponents I) := by
  intro a b hab ha
  have h : Finsupp.equivFunOnFinite.symm a ≤ Finsupp.equivFunOnFinite.symm b := hab
  obtain ⟨c, hc⟩ := le_iff_exists_add.mp h
  have hm := I.mul_mem_right (monomial c (1 : R)) ha
  rw [monomial_mul_monomial, mul_one, ← hc] at hm
  exact hm

theorem IsMonomial.le_of_monomialExponents_subset
    {I J : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)} (hI : IsMonomial I)
    (h : monomialExponents I ⊆ monomialExponents J) : I ≤ J := by
  obtain ⟨S, hS⟩ := hI
  rw [hS]
  apply Ideal.span_le.mpr
  rintro _ ⟨a, ha, rfl⟩
  have hm : monomial a (1 : R) ∈ I := hS.symm ▸ Ideal.subset_span ⟨a, ha, rfl⟩
  have hma : Finsupp.equivFunOnFinite a ∈ monomialExponents I := by
    simpa only [monomialExponents, Set.mem_ofPred_eq, Equiv.symm_apply_apply] using hm
  change monomial a (1 : R) ∈ J
  simpa only [monomialExponents, Set.mem_ofPred_eq, Equiv.symm_apply_apply] using h hma

theorem IsMonomial.isHomogeneous {I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)} (hI : IsMonomial I) :
    I.IsHomogeneous (Hilbert.Polynomial.GradedHilbert.grading R n) := by
  obtain ⟨S, rfl⟩ := hI
  apply Ideal.homogeneous_span
  rintro _ ⟨a, ha, rfl⟩
  exact ⟨a.degree, isHomogeneous_monomial (1 : R) rfl⟩

theorem IsMonomial.mem_iff_support [Nontrivial R]
    {I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)} (hI : IsMonomial I) (f : Hilbert.Polynomial.GradedHilbert.CoordinateRing R n) :
    f ∈ I ↔ ∀ a ∈ f.support, monomial a (1 : R) ∈ I := by
  classical
  obtain ⟨S, rfl⟩ := hI
  simp only [mem_ideal_span_monomial_image, support_monomial, one_ne_zero, ↓reduceIte,
    Finset.mem_singleton, forall_eq]

/-- Maclagan's theorem for actual monomial ideals. -/
theorem monomialIdeals_reverse_wellQuasiOrdered :
    WellQuasiOrdered (fun I J : {I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n) // IsMonomial I} =>
      J.val ≤ I.val) := by
  intro seq
  obtain ⟨i, j, hij, h⟩ := MonomialFinitenessIs.MonomialFiniteness.upper_sets_reverse_wellQuasiOrdered
    (fun i => ⟨monomialExponents (seq i).val, monomialExponents_isUpperSet _⟩)
  exact ⟨i, j, hij, (seq j).property.le_of_monomialExponents_subset h⟩

theorem IsMonomial.finite_generators {I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing R n)} (hI : IsMonomial I) :
    ∃ G : Finset (Fin (n + 1) →₀ ℕ),
      I = Ideal.span ((fun a => monomial a (1 : R)) '' (G : Set (Fin (n + 1) →₀ ℕ))) := by
  classical
  obtain ⟨G, hG⟩ := MonomialFinitenessIs.MonomialFiniteness.upper_set_finitely_generated
    (monomialExponents I) (monomialExponents_isUpperSet I)
  let F : Finset (Fin (n + 1) →₀ ℕ) := G.image Finsupp.equivFunOnFinite.symm
  refine ⟨F, le_antisymm ?_ ?_⟩
  · apply hI.le_of_monomialExponents_subset
    intro a ha
    obtain ⟨b, hb, hba⟩ := (hG a).mp ha
    apply monomialExponents_isUpperSet _ hba
    apply Ideal.subset_span
    exact ⟨Finsupp.equivFunOnFinite.symm b, Finset.mem_image.mpr ⟨b, hb, rfl⟩, rfl⟩
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ha
    exact (hG b).mpr ⟨b, hb, le_rfl⟩

variable {K : Type u} [Field K]

/-- There are only finitely many saturated monomial ideals with a given
Hilbert polynomial, with the number of variables fixed. -/
theorem finite_saturated_monomial_ideals (n : ℕ) (P : Polynomial ℚ) :
    {I : HomogeneousIdeal (Hilbert.Polynomial.GradedHilbert.grading K n) |
      IsMonomial I.toIdeal ∧ Hilbert.Polynomial.GradedHilbert.IsSaturated I.toIdeal ∧ Hilbert.Polynomial.GradedHilbert.HasHilbertPolynomial I.toIdeal P}.Finite := by
  classical
  by_contra hinf
  let e := Set.Infinite.natEmbedding _ hinf
  let seq (i : ℕ) : {I : Ideal (Hilbert.Polynomial.GradedHilbert.CoordinateRing K n) // IsMonomial I} :=
    ⟨(e i).val.toIdeal, (e i).property.1⟩
  obtain ⟨i, j, hij, hle⟩ := monomialIdeals_reverse_wellQuasiOrdered seq
  have heq : (e j).val = (e i).val :=
    Hilbert.Polynomial.GradedHilbert.saturated_eq_of_le_same_hilbertPolynomial (e j).val (e i).val hle
      (e j).property.2.1 P (e j).property.2.2 (e i).property.2.2
  exact hij.ne (e.injective (Subtype.ext heq)).symm

/-- A uniform generator-degree bound for the saturated monomial ideals
with the specified Hilbert polynomial. The bound is obtained from their
proved finiteness. -/
theorem exists_uniform_saturated_monomial_degree_bound (n : ℕ) (P : Polynomial ℚ) :
    ∃ N : ℕ, ∀ I : HomogeneousIdeal (Hilbert.Polynomial.GradedHilbert.grading K n),
      IsMonomial I.toIdeal → Hilbert.Polynomial.GradedHilbert.IsSaturated I.toIdeal → Hilbert.Polynomial.GradedHilbert.HasHilbertPolynomial I.toIdeal P →
      ∃ G : Finset (Fin (n + 1) →₀ ℕ),
        I.toIdeal = Ideal.span ((fun a => monomial a (1 : K)) ''
          (G : Set (Fin (n + 1) →₀ ℕ))) ∧ ∀ a ∈ G, a.degree ≤ N := by
  classical
  let S := {I : HomogeneousIdeal (Hilbert.Polynomial.GradedHilbert.grading K n) |
    IsMonomial I.toIdeal ∧ Hilbert.Polynomial.GradedHilbert.IsSaturated I.toIdeal ∧ Hilbert.Polynomial.GradedHilbert.HasHilbertPolynomial I.toIdeal P}
  have hS : S.Finite := finite_saturated_monomial_ideals n P
  let := hS.fintype
  choose G hG using fun I : S => I.property.1.finite_generators
  refine ⟨Finset.univ.sup (fun I : S => (G I).sup Finsupp.degree), ?_⟩
  intro I hMon hSat hP
  let J : S := ⟨I, hMon, hSat, hP⟩
  refine ⟨G J, hG J, fun a ha => ?_⟩
  exact (Finset.le_sup (f := Finsupp.degree) ha).trans
    (Finset.le_sup (f := fun I : S => (G I).sup Finsupp.degree) (Finset.mem_univ J))

end

end OAI.AlgebraicGeometry.HilbertScheme.Presentations.SaturatedMonomialIdeals.GradedHilbert
