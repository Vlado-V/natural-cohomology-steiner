import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ProjectiveChart.Evaluation

/-! # Generators -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ProjectiveChart.Generators

noncomputable section

/-! Coordinate-generation criteria for surjectivity of projective chart evaluation. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

variable {R B : Type u} [CommRing R] [CommRing B] {n : ℕ}

/-- The image of chart evaluation is a subalgebra for the prescribed base-ring map. -/
def projectiveChartEvaluationRange [Algebra R B] (v : Fin (n + 1) → B)
    (i : Fin (n + 1)) (hi : v i = 1) : Subalgebra R B where
  __ := (Evaluation.projectiveChartEvaluation (algebraMap R B) v i hi).rangeS
  algebraMap_mem' r := ⟨HomogeneousLocalization.fromZeroRingHom (Projective.ProjectivePresentations.coordinateGrading R n) _
    (Projective.ProjectivePresentations.degreeZeroConstants R n r), Evaluation.projectiveChartEvaluation_constant _ v i hi r⟩

/-- Every supplied coordinate belongs to the image of chart evaluation. -/
theorem projectiveChartEvaluationRange_coordinate [Algebra R B]
    (v : Fin (n + 1) → B) (i : Fin (n + 1)) (hi : v i = 1) (j : Fin (n + 1)) :
    v j ∈ projectiveChartEvaluationRange (R := R) v i hi :=
  ⟨_, Evaluation.projectiveChartEvaluation_coordinate (algebraMap R B) v i hi j⟩

/-- The image is exactly the subalgebra generated by the normalized coordinates. -/
theorem projectiveChartEvaluationRange_eq_adjoin [Algebra R B]
    (v : Fin (n + 1) → B) (i : Fin (n + 1)) (hi : v i = 1) :
    projectiveChartEvaluationRange (R := R) v i hi = Algebra.adjoin R (Set.range v) := by
  apply le_antisymm
  · rintro b ⟨x, rfl⟩
    obtain ⟨d, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (Projective.ProjectivePresentations.coordinateGrading R n) (MvPolynomial.isHomogeneous_X R i) x
    have hp' : p ∈ Projective.ProjectivePresentations.coordinateGrading R n d := by simpa only [smul_eq_mul, mul_one] using hp
    have he := Evaluation.projectiveChartEvaluation_mk (algebraMap R B) v i hi d p hp'
    rw [he, ← MvPolynomial.aeval_range]
    exact ⟨p, rfl⟩
  · exact Algebra.adjoin_le (fun _ ⟨j, hj⟩ =>
      hj ▸ projectiveChartEvaluationRange_coordinate (R := R) v i hi j)

/-- If the normalized coordinates generate the target algebra, evaluation is surjective. -/
theorem projectiveChartEvaluation_surjective [Algebra R B]
    (v : Fin (n + 1) → B) (i : Fin (n + 1)) (hi : v i = 1)
    (hv : Algebra.adjoin R (Set.range v) = ⊤) :
    Function.Surjective (Evaluation.projectiveChartEvaluation (algebraMap R B) v i hi) := by
  have hle : Algebra.adjoin R (Set.range v) ≤ projectiveChartEvaluationRange (R := R) v i hi :=
    Algebra.adjoin_le (fun _ ⟨j, hj⟩ =>
      hj ▸ projectiveChartEvaluationRange_coordinate (R := R) v i hi j)
  rw [hv] at hle
  intro b
  exact hle (show b ∈ (⊤ : Subalgebra R B) from trivial)

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ProjectiveChart.Generators
