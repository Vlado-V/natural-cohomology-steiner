import OAI.AlgebraicGeometry.SheafCohomology.Projective.MvPolynomialClosure

/-! # Space Hyperplane -/

namespace OAI.AlgebraicGeometry.SheafCohomology.Projective.SpaceHyperplane.MvPolynomial

noncomputable section

open _root_.MvPolynomial

/-

ForMathlib (OURS, not vendored): upstream candidate.
-/

/-!
# Coordinate hyperplanes in projective space

This file constructs the coordinate hyperplane `X_j = 0` as the `Proj` of the
corresponding homogeneous quotient. Its ideal sheaf will be the concrete model
of `O(-1)` used in the projective-space cohomology calculation.
-/

open _root_.AlgebraicGeometry _root_.HomogeneousIdeal

universe u

variable {R : Type u} {σ : Type*} [CommRing R]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The homogeneous ideal generated by one projective coordinate. -/
def coordinateHyperplaneIdeal (j : σ) :
    HomogeneousIdeal (homogeneousSubmodule σ R) :=
  ⟨Ideal.span {X j}, Ideal.homogeneous_span _ _ fun x hx => by
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact ⟨1, SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j⟩⟩

@[simp]
lemma coordinateHyperplaneIdeal_toIdeal (j : σ) :
    (coordinateHyperplaneIdeal (R := R) j).toIdeal = Ideal.span {X j} :=
  rfl

/-- The coordinate hyperplane as a projective homogeneous quotient. -/
abbrev coordinateHyperplane (j : σ) :=
  Proj (GradedQuotient.HomogeneousIdeal.quotientGrading (coordinateHyperplaneIdeal (R := R) j))

/-- The coordinate hyperplane embedded in polynomial projective space. -/
def coordinateHyperplaneι (j : σ) :
    coordinateHyperplane (R := R) j ⟶ Proj (homogeneousSubmodule σ R) :=
  Proj.map (GradedQuotient.HomogeneousIdeal.quotientGradingHom (coordinateHyperplaneIdeal (R := R) j))
    (GradedQuotient.HomogeneousIdeal.quotientGradingHom_irrelevant_le (coordinateHyperplaneIdeal (R := R) j))

/-- A coordinate hyperplane is a closed subscheme of polynomial projective space. -/
lemma coordinateHyperplaneι_isClosedImmersion (j : σ) :
    IsClosedImmersion (coordinateHyperplaneι (R := R) j) :=
  ClosedImmersion.HomogeneousIdeal.isClosedImmersion_proj_map_quotientGradingHom
    (coordinateHyperplaneIdeal (R := R) j)

variable {τ : Type}

local instance (j : τ) : IsClosedImmersion (coordinateHyperplaneι (R := R) j) :=
  coordinateHyperplaneι_isClosedImmersion j

/-- Away from its own coordinate chart, the coordinate hyperplane has local
equation `X_j / X_i`. -/
lemma coordinateHyperplaneι_ker_ideal_coordinateOpen_of_ne
    (i j : τ) (hji : j ≠ i) :
    (coordinateHyperplaneι (R := R) j).ker.ideal
        (⟨MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) i, by
          exact MvPolynomialClosure.MvPolynomial.coordinateOpen_isAffineOpen (R := R) i⟩ :
          (Proj (homogeneousSubmodule τ R)).affineOpens) =
      Ideal.span
        {(Proj.basicOpenIsoAway (homogeneousSubmodule τ R) (X i)
          (SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R i) one_pos).hom.hom
            (SpaceChart.MvPolynomial.awayVar R i ⟨j, hji⟩)} := by
  rw [coordinateHyperplaneι,
    ClosedImmersion.HomogeneousIdeal.ker_ideal_proj_map_quotientGradingHom_basicOpen
      (hs := SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R i)]
  rw [ClosedImmersion.HomogeneousIdeal.ker_away_map_quotientGradingHom
    (hF := SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j)
    (hI := coordinateHyperplaneIdeal_toIdeal j)
    (hs := SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R i)]
  rw [Ideal.map_span, Set.image_singleton]
  rfl

/-- On the chart where its defining coordinate is invertible, the coordinate
hyperplane has unit ideal. -/
lemma coordinateHyperplaneι_ker_ideal_coordinateOpen_self (j : τ) :
    (coordinateHyperplaneι (R := R) j).ker.ideal
        (⟨MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j, by
          exact MvPolynomialClosure.MvPolynomial.coordinateOpen_isAffineOpen (R := R) j⟩ :
          (Proj (homogeneousSubmodule τ R)).affineOpens) = ⊤ := by
  rw [coordinateHyperplaneι,
    ClosedImmersion.HomogeneousIdeal.ker_ideal_proj_map_quotientGradingHom_basicOpen
      (hs := SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j)]
  rw [ClosedImmersion.HomogeneousIdeal.ker_away_map_quotientGradingHom
    (hF := SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j)
    (hI := coordinateHyperplaneIdeal_toIdeal j)
    (hs := SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j)]
  rw [Ideal.map_span, Set.image_singleton]
  have hmk :
      HomogeneousLocalization.Away.mk (homogeneousSubmodule τ R)
          (SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j) 1 (X j)
          (by simpa using SpaceChart.MvPolynomial.X_mem_homogeneousSubmodule_one R j) = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
    convert Localization.mk_self_mk (X j : MvPolynomial τ R)
      (show X j ∈ Submonoid.powers (X j : MvPolynomial τ R) from
        ⟨1, pow_one _⟩) using 1
    apply congrArg (Localization.mk (X j : MvPolynomial τ R))
    exact Subtype.ext (pow_one _)
  rw [hmk, map_one, Ideal.span_singleton_one]

end

end OAI.AlgebraicGeometry.SheafCohomology.Projective.SpaceHyperplane.MvPolynomial
